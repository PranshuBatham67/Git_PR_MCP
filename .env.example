# Slack webhook URL for notifications
# Get from: https://api.slack.com/apps -> Your App -> Features -> Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Hugging Face API token for cloud AI integration
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here

# Optional: GitHub token for enhanced operations
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Note: LLM client now uses free local models (no API key needed!)
